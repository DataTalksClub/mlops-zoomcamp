            "uid": "postgres-mlops"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT details->>'cause' AS \"Cause\", count(*) AS \"Incidents\" FROM action_log WHERE agent='agent_fiabilite' AND action='incident_opened' AND $__timeFilter(timestamp) GROUP BY 1 ORDER BY 2 DESC"
