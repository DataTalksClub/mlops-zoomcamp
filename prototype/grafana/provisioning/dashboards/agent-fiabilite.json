      },
      "description": "Temps moyen entre l'ouverture d'un incident et sa résolution (Mean Time To Recovery)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Résolus automatiquement",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mlops"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mlops"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE NOT EXISTS (SELECT 1 FROM action_log h WHERE h.action='human_notified' AND h.details->>'incident_id' = r.details->>'incident_id' AND h.details->>'reason' LIKE 'toutes les actions%')) / NULLIF(count(*), 0) AS \"Autonomie\" FROM action_log r WHERE r.agent='agent_fiabilite' AND r.action='incident_resolved' AND $__timeFilter(r.timestamp)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Part des incidents réparés par l'agent seul. Un incident critique prévient toujours l'humain (information), mais ne compte comme intervention humaine que si l'agent a épuisé ses actions."
    },
    {
