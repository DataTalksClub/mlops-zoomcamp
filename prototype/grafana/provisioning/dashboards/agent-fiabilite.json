    {
      "id": 9,
      "type": "barchart",
      "title": "Incidents par cause",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mlops"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
