    {
      "id": 2,
      "type": "stat",
      "title": "MTTR moyen",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mlops"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mlops"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT avg((details->>'duration_seconds')::float) AS \"MTTR\" FROM action_log WHERE agent='agent_fiabilite' AND action='incident_resolved' AND $__timeFilter(timestamp)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
