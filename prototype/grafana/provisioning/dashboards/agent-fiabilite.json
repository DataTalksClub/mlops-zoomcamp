    {
      "id": 5,
      "type": "state-timeline",
      "title": "État du service",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mlops"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mlops"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT timestamp AS time, CASE WHEN NOT reachable THEN 'API injoignable' WHEN incident_level IS NULL THEN 'OK' ELSE 'incident ' || incident_level END AS \"Incident\", CASE WHEN degraded THEN 'mode dégradé' ELSE 'normal' END AS \"Service\" FROM reliability_metrics WHERE $__timeFilter(timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "OK": {
                  "color": "green",
                  "index": 0
                },
                "incident info": {
                  "color": "yellow",
                  "index": 1
                },
                "incident warning": {
                  "color": "orange",
                  "index": 2
                },
                "incident critical": {
                  "color": "red",
                  "index": 3
                },
                "API injoignable": {
                  "color": "dark-red",
                  "index": 4
                },
                "normal": {
                  "color": "green",
                  "index": 5
                },
                "mode dégradé": {
                  "color": "orange",
                  "index": 6
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
