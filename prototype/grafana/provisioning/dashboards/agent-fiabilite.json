    {
      "id": 10,
      "type": "barchart",
      "title": "MTTR par cause",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mlops"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mlops"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT details->>'cause' AS \"Cause\", round(avg((details->>'duration_seconds')::numeric), 0) AS \"MTTR (s)\" FROM action_log WHERE agent='agent_fiabilite' AND action='incident_resolved' AND $__timeFilter(timestamp) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Cause",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Actions de l'agent",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mlops"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mlops"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT details->>'action' AS \"Action\", count(*) FILTER (WHERE (details->>'success')::boolean) AS \"Réussies\", count(*) FILTER (WHERE NOT (details->>'success')::boolean) AS \"Échouées\" FROM action_log WHERE agent='agent_fiabilite' AND action LIKE 'action:%' AND $__timeFilter(timestamp) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Réussies"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Échouées"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Action",
        "stacking": "normal",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Derniers incidents résolus",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-mlops"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-mlops"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT r.timestamp AS \"Clôture\", r.details->>'incident_id' AS \"Incident\", r.details->>'cause' AS \"Cause\", r.details->>'level' AS \"Niveau\", (r.details->>'score')::int AS \"Score\", (r.details->>'duration_seconds')::float AS \"Durée\", (SELECT string_agg(a->>'action', ' → ') FROM json_array_elements(r.details->'actions') a) AS \"Actions\", r.details->>'degraded' AS \"Mode dégradé\" FROM action_log r WHERE r.agent='agent_fiabilite' AND r.action='incident_resolved' AND $__timeFilter(r.timestamp) ORDER BY r.timestamp DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Durée"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Niveau"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "info": {
                        "color": "yellow"
                      },
                      "warning": {
                        "color": "orange"
                      },
                      "critical": {
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
